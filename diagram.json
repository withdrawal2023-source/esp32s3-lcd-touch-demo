{
  "version": 1,
  "author": "ESP32-S3 Touch LCD Demo",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 60,
      "left": -40,
      "attrs": {
        "flashSize": "16",
        "psramSize": "8",
        "psramType": "octal"
      }
    },
    {
      "type": "board-ili9341-cap-touch",
      "id": "lcd1",
      "top": -100,
      "left": 260,
      "attrs": {}
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 180,
      "left": 300,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 180,
      "left": 380,
      "attrs": { "color": "green", "label": "LED" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "lcd1:VCC", "esp:3V3.1", "red", [] ],
    [ "lcd1:GND", "esp:GND.1", "black", [] ],
    [ "lcd1:CS", "esp:15", "green", [] ],
    [ "lcd1:RST", "esp:4", "orange", [] ],
    [ "lcd1:D/C", "esp:2", "yellow", [] ],
    [ "lcd1:MOSI", "esp:11", "blue", [] ],
    [ "lcd1:SCK", "esp:12", "purple", [] ],
    [ "lcd1:MISO", "esp:13", "cyan", [] ],
    [ "lcd1:LED", "esp:6", "white", [] ],
    [ "lcd1:SDA", "esp:8", "green", [] ],
    [ "lcd1:SCL", "esp:9", "green", [] ],
    [ "esp:21", "r1:1", "gold", [] ],
    [ "r1:2", "led1:A", "gold", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ]
  ]
}
